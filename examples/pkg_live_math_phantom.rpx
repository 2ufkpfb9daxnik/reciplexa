(// language-only: live-layout phantom — ker builtin math-phantom nested in a
 // row. Host inks "x" and skips Σ (not TeX smash-still-draws / OpenType MATH).)

(import document/page only
  a4 page flow section heading paragraph
  block-paragraph)

(val title (heading 1 "Phantom"))
(val body (paragraph "可視本文。ファントムは描かない。"))
(val math
  (record
    (tag "math-row")
    (children
      (list
        (record (tag "math-symbol") (glyph "x") (class "ord"))
        (math-phantom (record (tag "math-symbol") (glyph "Σ") (class "op")))))))

(val main
  (record
    (tag "live-layout-demo")
    (page
      (page a4
        (flow
          (list
            (section title
              (list
                (block-paragraph body)))))))
    (math math)))
