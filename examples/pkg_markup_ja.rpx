(// language-only: japanese/markup tree mirroring markup_ja @-forms.
 // SYN @heading/@note/... still expand via markup macros; this example shows
 // the package-record path that will bind to Text IR later.)
(import japanese/markup only
  heading section paragraph note warn todo ul ruby doc emphasis
  tategaki-paragraph tategaki-text markup-bridge doc-with-markup)
(import japanese/classes only cl-01 cl-19 cl-30 class-name)
(import japanese/linebreak only break-between kinsoku-profile)
(import japanese/kihon only
  default-horizontal-kihon default-vertical-kihon a5-trim margins place-hanmen
  vertical-flow vertical-stack tate-chu-yoko-span vertical-text place-vertical-text
  vertical-text-stack)
(val markup-source
  "(markup @heading(日本語レポート草稿) … see examples/markup_ja.rpx)")
(val draft
  (doc-with-markup "日本語レポート草稿" markup-source
    (list
      (heading "日本語レポート草稿")
      (paragraph "これは禁則処理のごく初期スライスです。")
      (note "JLReq の本格実装はこれから。")
      (section "箇条書き")
      (ul (list "第一項目です。" "第二項目（補足）です。"))
      (emphasis "強調")
      (ruby "漢字" "かんじ")
      (tategaki-paragraph "縦書き段落のスタブです。")
      (tategaki-text 120 40 4 "縦組み")
      (vertical-text 130 40 4 "graphics-bridge")
      (place-vertical-text 140 40 4 "配置スタブ")
      (todo "禁則をもう少し厚くする。")
      (warn "まだフォントウェイトはない。"))))
(val layout
  (place-hanmen a5-trim (margins 20 20 20 20) default-horizontal-kihon))
(val vertical-layout
  (vertical-flow
    (vertical-stack
      (list
        (tategaki-paragraph "縦組み")
        (tate-chu-yoko-span "2026")))))
(val kinsoku-sample (break-between 19 6))
(val main
  (record (tag "markup-ja-package-demo")
    (markup-bridge (markup-bridge "日本語レポート草稿" markup-source))
    (draft draft)
    (layout layout)
    (vertical-layout vertical-layout)
    (vertical-kihon default-vertical-kihon)
    (kinsoku kinsoku-sample)
    (kinsoku-profile kinsoku-profile)
    (cl-19-name (class-name 19))
    (cl-30-name (class-name 30))))
