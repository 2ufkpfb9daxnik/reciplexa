(// language-only: Migrated Slice D — package graphics constructors.)
(// GUI regression still uses interim examples like black_circle.rpx.)
(import graphics/shapes only
  circle rect ellipse ring frame text fill stroke group)
(import graphics/page only a4 page)
(import graphics/color only black red blue rgb)
(val main
  (page a4
    (group
      (list
        (fill (rect 30 40 150 80) (rgb 0.85 0.9 0.95))
        (fill (circle 105 148.5 28) red)
        (fill (ellipse 105 220 55 28) (rgb 0.15 0.45 0.7))
        (stroke (circle 60 220 22) 2 blue)
        (frame 140 190 50 55 1.5 black)
        (text 30 270 6 "shapes")))))
