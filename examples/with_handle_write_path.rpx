; M9: handle write-path mute (logs still fire)
(src
  (perform write-path "before.pdf")
  (handle write-path
    (perform write-path "should-stay-silent.pdf")
    (perform log "inside handle"))
  (perform write-path "after.pdf"))

(page a4
  (text 30 260 7 "handle write-path demo" black)
  (circle 105 140 28 (color-byte 60 100 160)))
