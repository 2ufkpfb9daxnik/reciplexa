(// Vertical-rl demo (Step 8 item 2). Columns go top-to-bottom, next column to the left.
 // CJK stays upright (`vert` GID when the face has GSUB). ASCII rotates −90°.)

(import document/page only
  a4 page flow section heading paragraph
  block-heading block-paragraph)

(val samples (list "縦書き" "東京。あー、" "天ー気" "ABC"))

(val title (heading 1 "Vertical writing"))
(val body (paragraph "上から下へ。右の列から左へ。句点は vert、ABC は回転。"))

(val main
  (record
    (tag "ja-vertical-demo")
    (placed "縦書き")
    (samples samples)
    (page
      (page a4
        (flow
          (list
            (section title
              (list
                (block-heading title)
                (block-paragraph body)))))))))
