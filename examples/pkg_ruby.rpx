(// Simple horizontal ruby demo (Step 8 item 1).
 // Product preview: heading + three samples. Annotation is half-size, centered
 // above the parent em-square. jukugo / vert are not this file.)

(import japanese/markup only ruby)

(import document/page only
  a4 page flow section heading paragraph
  block-heading block-paragraph)

(val placed (ruby "東京" "とうきょう"))
(val kanji (ruby "漢字" "かんじ"))
(val one (ruby "一" "いち"))
(val samples (list placed kanji one))
(val metrics (ruby-box "東京" "とうきょう"))

(val title (heading 1 "Simple ruby"))
(val body (paragraph "親文字の真上に半分サイズのルビ。ルビが長いときは親文字幅の中央に置き、行送りは親文字幅のみ。"))

(val main
  (record
    (tag "ja-ruby-demo")
    (ruby metrics)
    (placed placed)
    (samples samples)
    (page
      (page a4
        (flow
          (list
            (section title
              (list
                (block-heading title)
                (block-paragraph body)))))))))
