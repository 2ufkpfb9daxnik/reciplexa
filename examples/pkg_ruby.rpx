(// language-only: ker builtin ruby-box + japanese/markup ruby.
 // Stub preview uses nested document/page. Host product lays out `placed`.)

(import japanese/markup only ruby)

(import document/page only
  a4 page flow section heading paragraph
  block-heading block-paragraph)

(val placed (ruby "東京" "とうきょう"))
(val metrics (ruby-box "東京" "とうきょう"))

(val title (heading 1 "Ruby box"))
(val body (paragraph "東京（とうきょう）— fontless ruby-box metrics, not JLReq placement."))

(val main
  (record
    (tag "ja-ruby-demo")
    (ruby metrics)
    (placed placed)
    (page
      (page a4
        (flow
          (list
            (section title
              (list
                (block-heading title)
                (block-paragraph body)))))))))
