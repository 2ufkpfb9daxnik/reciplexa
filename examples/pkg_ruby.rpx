(// Simple horizontal ruby demo (Step 8 item 1; Step 12 slice 3 jukugo).
 // Product preview: heading + samples. Simple ruby centers on parent width;
 // jukugo-ruby splits annotation per base character.)

(import japanese/markup only ruby jukugo-ruby)

(import document/page only
  a4 page flow section heading paragraph
  block-heading block-paragraph)

(val placed (ruby "東京" "とうきょう"))
(val jukugo-sample (jukugo-ruby "東京" "とうきょう"))
(val kanji (ruby "漢字" "かんじ"))
(val one (ruby "一" "いち"))
(val samples (list placed jukugo-sample kanji one))
(val metrics (ruby-box "東京" "とうきょう"))

(val title (heading 1 "Simple ruby"))
(val body (paragraph "親文字の真上に半分サイズのルビ。simple は親幅中央、jukugo-ruby は各親文字ごとに配分。"))

(val main
  (record
    (tag "ja-ruby-demo")
    (ruby metrics)
    (placed placed)
    (samples samples)
    (page
      (page a4
        (flow
          (list
            (section title
              (list
                (block-heading title)
                (block-paragraph body)))))))))
