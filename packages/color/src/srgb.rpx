(// color/srgb — standalone color package.)
(val srgb (fn (r g b)
  (record (tag "srgb") (r r) (g g) (b b))))
(val black (record (tag "srgb") (r 0) (g 0) (b 0)))
(val white (record (tag "srgb") (r 1) (g 1) (b 1)))
(val red (record (tag "srgb") (r 1) (g 0) (b 0)))
(val green (record (tag "srgb") (r 0) (g 1) (b 0)))
(val blue (record (tag "srgb") (r 0) (g 0) (b 1)))
