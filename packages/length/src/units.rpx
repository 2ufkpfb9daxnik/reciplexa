(// length/units — millimeter helper.)
(// Number+Ident unit suffixes remain interim in the lexer.)
(// Public vals are self-contained so .rpi export filtering can copy them.)
(val mm (fn (value)
  (record (unit "mm") (value value))))
(val cm (fn (value)
  (record (unit "cm") (value value))))
(val pt (fn (value)
  (record (unit "pt") (value value))))
(val inch (fn (value)
  (record (unit "inch") (value value))))
(val zero (record (unit "mm") (value 0)))
