(// graphics/shapes — package shape constructors; not language builtins.)
(// Exported as fns so MOD import linking can bind them.)
(val circle (fn (x y r)
  (record (tag "circle") (x x) (y y) (r r))))
(val rect (fn (x y w h)
  (record (tag "rect") (x x) (y y) (w w) (h h))))
(val ellipse (fn (x y rx ry)
  (record (tag "ellipse") (x x) (y y) (rx rx) (ry ry))))
